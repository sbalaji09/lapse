LAPSE_BACKEND=local

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_VERIFY=gpt-4.1

# AWS Bedrock: one Bedrock API key is the only credential needed for local development.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0
BEDROCK_MODEL_VERIFY=amazon.nova-pro-v1:0
# The provision command writes these non-secret values to .cache automatically.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

EMAIL_BACKEND=local
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lapse <onboarding@resend.dev>
EMAIL_TIMEOUT_SECONDS=15
DEMO_INBOX=siddharthbalaji6@gmail.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Voice outreach defaults to a safe local simulator.
VOICE_BACKEND=local
VOICE_AUTOMATION_ENABLED=1
VOICE_ESCALATION_MINUTES=1440
VOICE_RETRY_MINUTES=1440
VOICE_MAX_ATTEMPTS=2
VOICE_CALL_TIMEOUT_MINUTES=10
VOICE_TIMEZONE=America/Los_Angeles
VOICE_CALL_START_HOUR=9
VOICE_CALL_END_HOUR=18
VOICE_SCHEDULER_INTERVAL_SECONDS=60
VOICE_MESSAGE_LANGUAGE=en

# Controlled destination for Rosa's real demo call.
VOICE_DESTINATION_PHONE=+14086100377

# Required only for VOICE_BACKEND=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
# Optional public HTTPS API origin for signed Twilio status callbacks.
LAPSE_PUBLIC_API_URL=
