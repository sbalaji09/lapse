LAPSE_BACKEND=local

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_VERIFY=gpt-4.1

# Bedrock: prefer AWS_PROFILE with IAM Identity Center. Access keys are for synthetic local development only.
AWS_REGION=us-west-2
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0
BEDROCK_MODEL_VERIFY=amazon.nova-pro-v1:0
# Set by scripts/provision_guardrail.py; its local cache file is also discovered automatically.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=
# AWS_PROFILE=lapse-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

RESEND_API_KEY=
DEMO_INBOX=
NEXT_PUBLIC_API_URL=http://localhost:8000
