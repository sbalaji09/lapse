LAPSE_BACKEND=local

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_VERIFY=gpt-4.1

# AWS Bedrock: one Bedrock API key is the only credential needed for local development.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0
BEDROCK_MODEL_VERIFY=amazon.nova-pro-v1:0
# The provision command writes these non-secret values to .cache automatically.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

RESEND_API_KEY=
DEMO_INBOX=
NEXT_PUBLIC_API_URL=http://localhost:8000
